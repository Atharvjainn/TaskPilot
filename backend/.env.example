# ==========================================================
# Groq API Configuration (Fast LPU Inference)
# Get your free key at: https://console.groq.com/keys
# ==========================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================================
# Database Connection (Neon PostgreSQL or SQLite fallback)
# ==========================================================
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_neon_url_here
 
# ==========================================================
# Frontend URL (Optional: restricts CORS in production)
# Example: https://taskpilot.vercel.app,http://localhost:3000
# Defaults to "*" (all origins) if omitted
# ==========================================================
# FRONTEND_URL=https://your-frontend-app.vercel.app
